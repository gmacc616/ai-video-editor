# Media and per-job work: big, regenerated per job (finished videos are downloaded from the session)
/downloads/
/jobs/
/videos/
/output/
*.part
.render.lock

# OpenMontage for /montage: installed by tools/montage/setup.sh at a pinned commit (holds .env with the user's API keys)
/vendor/

# Local-only machine state
.claude/settings.local.json
.claude/backups/
node_modules/
__pycache__/
*.pyc
.env
*.log

# Empty stub folders the skills installer made for ~50 other coding agents, and its root symlinks
/.*/
!/.claude/
!/.agents/
!/.github/
/skills/

