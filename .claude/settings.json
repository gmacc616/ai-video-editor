{
  "env": {
    "RTK_SUPPRESS_HOOK_WARNING": "1",
    "RTK_TELEMETRY_DISABLED": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v rtk >/dev/null 2>&1 && exec rtk hook claude || exit 0"
          }
        ]
      }
    ]
  },
  "outputStyle": "Token Saver"
}
